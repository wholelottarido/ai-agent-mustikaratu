# ============================================================
# Template kredensial. Salin jadi .env.local lalu isi nilainya.
#   cp .env.example .env.local
# .env.local TIDAK di-commit (lihat .gitignore).
# ============================================================

# --- Model (Anthropic Claude) ---
ANTHROPIC_API_KEY=

# --- Server MySQL (dipakai bersama semua departemen) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306

# --- Kredensial PER DEPARTEMEN ---
# Tiap departemen punya user MySQL sendiri yang HANYA boleh SELECT ke
# database-nya sendiri. Ini batas yang sesungguhnya antar departemen --
# bukan kalimat di system prompt. Jangan pakai satu user untuk semuanya.

# Marketing -- dibuat lewat db/01_create_readonly_user.sql
MARKETING_DB_NAME=marketing
MARKETING_DB_USER=mkt_readonly
MARKETING_DB_PASSWORD=isi_password_disini

# HR -- dibuat lewat db/hr/01_create_readonly_user.sql
# DUA user: staf tidak bisa baca kolom gaji, kepala bisa.
HR_DB_NAME=hr
HR_DB_USER=hr_readonly
HR_DB_PASSWORD=isi_password_disini
HR_KEPALA_DB_NAME=hr
HR_KEPALA_DB_USER=hr_kepala
HR_KEPALA_DB_PASSWORD=isi_password_disini

# --- Sesi login ---
# Kunci penanda tangan JWT. Buat yang acak, JANGAN pakai contoh ini:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# --- Database portal (daftar akun) ---
# Dibuat lewat db/portal/01_create_portal.sql
PORTAL_DB_NAME=portal
PORTAL_DB_USER=portal_readonly
PORTAL_DB_PASSWORD=isi_password_disini

# --- Penulis basis pengetahuan ---
# Role terpisah dari portal_login dan ai_readonly. Buat dengan:
#   npm run buat:pg-ingest
DEMO_PG_INGEST_USER=ai_ingest
DEMO_PG_INGEST_PASSWORD=isi_password_ingest_disini

# --- OCR untuk gambar yang diunggah ke basis pengetahuan ---
# Installer Tesseract Windows TIDAK memasang bahasa Indonesia -- isinya cuma
# `eng` dan `osd`. Kalau `ind` tidak ada, OCR tidak gagal: dia jalan dengan
# model Inggris dan hasilnya salah ketik di mana-mana, lalu tersimpan begitu
# saja. Diukur pada gambar mirip foto HP: eng 73% kata salah, ind 41%.
# Siapkan dengan:
#   npm run pasang:ocr-ind
# Bandingkan sendiri dengan:
#   npm run banding:ocr -- <gambar> <kunci.txt>
TESSERACT_PATH=
TESSERACT_LANG=ind
# Folder berkas bahasa. Kosongkan untuk memakai ~/.cache/tessdata (bawaan).
# Program Files tidak dipakai karena menulis ke situ perlu hak admin.
TESSDATA_DIR=

# User aplikasi untuk riwayat percakapan -- SATU-SATUNYA yang boleh menulis.
# Dibuat lewat db/portal/03_percakapan.sql
PORTAL_APP_DB_USER=portal_app
PORTAL_APP_DB_PASSWORD=isi_password_disini

# --- Model lokal (Ollama) ---
# Opsional. Kalau Ollama tidak jalan, model lokal di dropdown akan menolak
# dengan pesan jelas; model Claude tetap bisa dipakai.
# Perhatikan: /api (endpoint NATIVE), BUKAN /v1 -- tool calling lewat /v1
# terbukti tidak andal (2 dari 5 percobaan gagal).
OLLAMA_HOST=http://localhost:11434/api

# Kuota pertanyaan per pengguna untuk model BERBAYAR (Claude).
# Model lokal (Ollama) tidak dibatasi -- tidak memakai kredit API.
# Kosongkan untuk memakai bawaan: 20/jam, 80/hari.
KUOTA_PER_JAM=20
KUOTA_PER_HARI=80

# User khusus halaman pendaftaran. Izinnya cuma INSERT ke tabel
# `pendaftaran` + baca 3 kolom untuk pembatas IP -- tidak bisa membaca
# password pendaftar lain, tidak bisa menyentuh tabel `pengguna`.
PORTAL_DAFTAR_DB_USER=portal_daftar
PORTAL_DAFTAR_DB_PASSWORD=

# User khusus route admin. SATU-SATUNYA yang bisa menulis ke tabel
# `pengguna` -- dan tanpa DELETE. Jangan dipakai di jalur kode lain.
PORTAL_ADMIN_DB_USER=portal_admin
PORTAL_ADMIN_DB_PASSWORD=

# Nomor WhatsApp bot, ditampilkan di halaman /whatsapp supaya user tahu
# harus mengirim kodenya ke mana. Kosong = halaman cuma bilang 'nomor bot'.
NOMOR_BOT_WA=

# Kurs USD->Rupiah untuk perkiraan biaya. Kosong = 16500.
# ⚠️ Awalan NEXT_PUBLIC_ WAJIB: nilai ini dipakai di komponen klien, dan
# Next.js cuma menanamkan variabel berawalan itu ke bundel browser.
# ⚠️ Ter-bundel saat build -- ubah nilainya lalu build ulang.
NEXT_PUBLIC_KURS_USD=17900

# User penulis entri data. SATU-SATUNYA yang bisa menulis ke database
# marketing, dan cuma ke 3 tabel: sales_order, sales_order_line, entri_log.
# TANPA UPDATE & DELETE -- koreksi sementara lewat root, itu disengaja.
MARKETING_ENTRY_DB_USER=mkt_entry
MARKETING_ENTRY_DB_PASSWORD=

# ============================================================
# Login akun perusahaan (Tahap 10A)
# ============================================================
# Role PostgreSQL KHUSUS login, TERPISAH dari DEMO_PG_USER (ai_readonly).
#
# ⚠️ Pemisahan ini bukan kerapian, tapi pengaman. Kalau hak memanggil
# cek_login_perusahaan() diberikan ke role agent, model bisa menulis
#   SELECT cek_login_perusahaan('budi@...','tebakan1')
# dan penjaga SQL kita TIDAK menangkapnya -- penjaga itu memeriksa nama tabel
# di FROM/JOIN, sedangkan query tadi tidak punya FROM. Jadilah alat menebak
# password. Role terpisah menutup itu sepenuhnya.
#
# Hak role ini cuma dua: EXECUTE cek_login_perusahaan, SELECT v_login_profil.
# Tidak bisa membaca tabel users, employee, maupun view agent.
#
# Passwordnya bebas (buat yang panjang), diisi sendiri, lalu jalankan:
#   npm run buat:pg-login   -> membuat role, fungsi, view
#   npm run uji:pg-login    -> membuktikan kuncinya benar
DEMO_PG_LOGIN_USER=portal_login
DEMO_PG_LOGIN_PASSWORD=

# Password akun UJI di database perusahaan (`npm run uji:akun`).
#
# ⚠️ Akun itu DITULIS ke database perusahaan — satu-satunya tulisan kita ke
# sana. Gunanya menutup bagian yang tidak bisa diuji tanpa kredensial sah:
# membuktikan crypt() MENERIMA password yang benar, dan layar pemilih profil
# muncul. Namanya sengaja mencolok ("UJI PORTAL ...", @contoh.test) supaya
# kalau muncul di laporan orang lain langsung ketahuan itu data uji.
#
# Bersihkan setelah selesai:  npm run uji:akun -- --hapus
UJI_AKUN_PASSWORD=

# Password akun UJI departemen IT (`npm run uji:akun -- it`).
# Akunnya ridho@mustika-ratu.co.id, 2 profil helpdesk (staf & lead).
UJI_AKUN_IT_PASSWORD=

# Password akun UJI MAPS (`npm run uji:akun -- maps`).
# Akunnya dafi@mustika-ratu.co.id, 1 profil "Trade Marketing Executive".
#
# Departemennya "Trade Marketing", BUKAN "MAPS" -- portal cuma menerima
# departemen yang terpetakan (marketing/hr/it), dan profil di luar itu dibuang
# sehingga akunnya ada tapi tidak bisa login. Trade Marketing juga memegang
# 16.783 dari 29.199 klaim MAPS, jadi cakupan `departemen` kelihatan bekerja.
UJI_AKUN_MAPS_PASSWORD=

# ============================================================
# Pembaca gambar (OCR)
# ============================================================
# `claude` (bawaan) atau `lokal`.
#
# ⚠️ `claude` berarti GAMBAR KELUAR dari laptop ke server Anthropic. Itu
# keputusan sadar 30 Sep 2026, bukan bawaan yang kebetulan: granite lokal
# TIDAK BISA jalan di mesin ini (butuh ~2,4 GB, RAM bebas 0,0-0,4 GB dari
# 7,3 GB). Diukur berdampingan pada screenshot berbahasa Indonesia:
#
#     granite lokal : GAGAL kehabisan memori (63 dtk waktu sempat jalan)
#     Claude Haiku  : 2,9 detik, seluruh teks benar, ~Rp 18 per gambar
#
# Ganti ke `lokal` begitu ada mesin dengan RAM cukup -- jalurnya masih ada.
#
# ⚠️ Tidak ada mode "lokal dulu, gagal baru cloud". Di mesin ini lokal SELALU
# gagal, jadi mode itu berarti user mengira dokumennya diproses lokal padahal
# setiap kali dikirim keluar.
OCR_PENYEDIA=claude

# ============================================================
# Jalur agent: `lama` (bawaan) atau `konfigurasi`
# ============================================================
# `lama`        — agent per DEPARTEMEN, ditulis tangan di
#                 voltagent/departemen/*. Model menulis SQL, lalu diperiksa
#                 sql-guard.
# `konfigurasi` — agent per APLIKASI, dibaca dari ai_agent/ai_tool di database
#                 perusahaan. Model TIDAK menulis SQL; query dirakit server
#                 dari baris konfigurasi, dan id_employee penyaringnya datang
#                 dari sesi login.
#
# Dikosongkan = `lama`. Nilai selain `konfigurasi` persis juga dianggap
# `lama` -- termasuk "1", "true", dan "KONFIGURASI".
#
# Kalau diisi `konfigurasi` tapi jalurnya tidak bisa dipakai (sesi tanpa
# id_employee, karyawan tidak ketemu, agent umum dimatikan), permintaannya
# JATUH ke jalur lama dan sebabnya dicatat sebagai warning di log server --
# tidak pernah diam-diam.
#
# Periksa dulu dengan: npm run test:jalur
JALUR_AGENT=

# ============================================================
# Role khusus UBAH setelan tool AI (npm run buat:pg-konfig)
# ============================================================
# Dipakai layar pengaturan di portal, TERPISAH dari `DEMO_PG_*` yang dipegang
# jalur chat. Hak UPDATE-nya diberikan PER KOLOM: role ini tidak bisa menyentuh
# `penangan`, `jenis`, `id_ai_sumber_data`, `tabel_target`, `kode`, maupun
# `id_apps` -- kolom yang menentukan APA yang dikerjakan tool, bukan setelannya.
#
# Jadi bug di route atau di validasi tidak bisa mengubah perilaku tool, cuma
# setelannya. Diperiksa tiap kali `npm run test:ubah-tool` jalan.
DEMO_PG_KONFIG_USER=ai_konfig
DEMO_PG_KONFIG_PASSWORD=

# ---------------------------------------------------------------------------
# Role PENULIS tiket helpdesk. Dibuat `npm run buat:pg-tulis` (perlu admin).
#
# ⚠️ BERI TAHU TIM PEMILIK `portal_ticket` SEBELUM MEMBUATNYA. Tabel itu bukan
# milik kita: 10.089 tiket, dan teknisi IT mengerjakan antreannya. Yang
# diberikan bukan sekadar akses database, melainkan kemampuan portal ini
# menambah pekerjaan ke daftar kerja orang lain.
#
# Hak INSERT-nya diberikan PER KOLOM. Role ini tidak bisa mengisi `status`,
# `id_technician`, `assigned_by`, `closed_at`, maupun `self_closed` -- jadi
# tiket buatan portal SELALU lahir berstatus OPEN dan belum ditugaskan,
# dijamin nilai bawaan kolomnya, bukan oleh kode kita.
#
# Tanpa dua baris ini, jalur rancangan tiket tetap jalan dan kartunya tetap
# muncul; yang gagal cuma penyimpanannya, dengan pesan yang menyebut sebabnya.
DEMO_PG_TULIS_USER=ai_tulis
DEMO_PG_TULIS_PASSWORD=

# ============================================================
# Qwen2.5 14B -- model di Google Colab, lewat tunnel Cloudflare
# ============================================================
# Endpoint OpenAI-compatible buatan sendiri (FastAPI). Dipakai lewat penyedia
# `qwen` di voltagent/models.ts.
#
# Kosongkan semuanya untuk mematikan: model ini hilang dari dropdown, dan
# penyedia lain (Claude, Ollama, Bifrost) tidak terpengaruh sama sekali.
#
# WAJIB https -- endpointnya di luar jaringan kantor dan memakai Bearer key.
# Lewat http:// kunci itu terkirim polos, jadi alamat non-HTTPS diperlakukan
# sebagai belum disetel. localhost dikecualikan untuk pengembangan.
#
# URL tunnel BERGANTI tiap Colab dijalankan ulang -- itu sifat quick tunnel
# `trycloudflare.com`, bukan kerusakan. Kalau model ini tiba-tiba gagal,
# perbarui QWEN_API_URL dulu sebelum mencurigai kode.
#
# `QWEN_ENABLED=false` mematikannya tanpa menghapus setelan lain.
# Perhatikan tanda `=`, bukan `:` -- baris yang memakai titik dua TIDAK
# terbaca sebagai variabel environment, dan gagalnya diam.
QWEN_ENABLED=true
QWEN_API_URL=
QWEN_API_KEY=
QWEN_MODEL=Qwen/Qwen2.5-14B-Instruct
QWEN_TIMEOUT_MS=180000
